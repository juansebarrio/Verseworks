# Resend — envío del formulario de enquiry
# 1. Crear cuenta en resend.com y verificar el dominio de Verseworks
# 2. Generar API key y cargarla acá y en Vercel (Project Settings → Environment Variables)
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=hello@verseworks.example
ENQUIRY_FROM_EMAIL="Verseworks <enquiries@dominio-verificado.com>"
