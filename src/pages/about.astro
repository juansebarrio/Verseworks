---
import Base from '../layouts/Base.astro';
// TODO: volcar el copy completo de ABOUT (aproach, red de colaboradores, founder).
---

<Base
  title="About — Verseworks"
  description="Verseworks is a multilingual poetry studio founded by Wided Rihana Khadraoui, creating live, participatory experiences through words."
>
  <section class="mx-auto max-w-[68rem] px-6 pt-[10vh] pb-16">
    <h1 class="font-display text-hero max-w-4xl text-ink">
      Poetry is not only something we read.
    </h1>
    <div class="font-reading mt-8 max-w-2xl space-y-2 text-xl text-ink">
      <p class="reveal">It can happen between strangers.</p>
      <p class="reveal">It can enter a room.</p>
      <p class="reveal">
        It can become an object, a performance, a question or a way of gathering
        people together.
      </p>
    </div>
  </section>

  <section class="border-t border-line">
    <div class="mx-auto max-w-[68rem] px-6 py-16">
      <p class="kicker reveal">Founder</p>
      <h2 class="font-display text-display reveal mt-4 text-ink">Wided Rihana Khadraoui</h2>
      <p class="reveal mt-6 max-w-2xl leading-relaxed text-ink-soft">
        Verseworks was founded by Wided Rihana Khadraoui, a published poet,
        cultural strategist and producer working across contemporary art,
        cultural institutions and international events. Verseworks grew from a
        simple idea: poetry can be presented not only as literature or
        performance, but as a generous live encounter between people.
      </p>
      <a href="/enquire" class="btn reveal mt-8">Work with Verseworks</a>
    </div>
  </section>
</Base>
