---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import installationSquare from '../assets/photos/installation-square.jpg';
import performanceCrowd from '../assets/photos/performance-crowd.jpg';
import printedMatter from '../assets/photos/printed-matter.jpg';
import workshopTable from '../assets/photos/workshop-table.jpg';

// TODO: volcar el copy completo de EXPERIENCES (ya redactado en el brief).
const blocks = [
  {
    id: 'live',
    title: 'Live Experiences',
    lead: 'Poems made on the spot, performances, poetic hosting and poems to take home.',
    cta: 'Plan a live experience',
    img: performanceCrowd,
    imgAlt: 'A poet performing surrounded by a standing audience in a contemporary venue',
    imgCaption: 'a room, listening',
    extra: printedMatter,
    extraAlt: 'Poetry posters and thin publications hanging from clips in a design studio',
    extraCaption: 'editions, hanging',
  },
  {
    id: 'programmes',
    title: 'Participatory Programmes',
    lead: 'Workshops, collective poems and community projects — no previous writing experience required.',
    cta: 'Create a participatory programme',
    img: workshopTable,
    imgAlt: 'A group talking and writing together around a large table during a workshop',
    imgCaption: 'the table, mid-poem',
  },
  {
    id: 'commissions',
    title: 'Creative Commissions',
    lead: 'Poetry in public space, bespoke texts, installations, publications and editions.',
    cta: 'Commission a poem',
    img: installationSquare,
    imgAlt: 'People walking between large text installations in a public square',
    imgCaption: 'verses, in the square',
  },
];
---

<Base
  title="Experiences — Verseworks"
  description="Poetry becomes an experience when someone enters it. Live experiences, participatory programmes and creative commissions."
>
  <section class="mx-auto max-w-[68rem] px-6 pt-[10vh] pb-16">
    <h1 class="font-display text-hero max-w-4xl text-ink">
      Poetry becomes an experience when someone enters it.
    </h1>
    <p class="mt-8 max-w-xl leading-relaxed text-ink-soft">
      Verseworks creates encounters that can be heard, held, entered,
      contributed to and taken home. Our work spans three areas.
    </p>
  </section>

  {
    blocks.map((b) => (
      <section id={b.id} class="border-t border-line scroll-mt-6">
        <div class="mx-auto max-w-[68rem] px-6 py-16">
          <h2 class="font-display text-display reveal text-ink">{b.title}</h2>
          <p class="font-reading reveal mt-5 max-w-2xl text-lg text-ink-soft">{b.lead}</p>
          <div class="mt-10 grid items-start gap-6 sm:grid-cols-3">
            <figure
              class:list={['reveal sm:col-span-2', b.id === 'commissions' && 'sm:col-start-2']}
            >
              <Image
                src={b.img}
                alt={b.imgAlt}
                class="aspect-[3/2] w-full object-cover mix-blend-multiply"
                widths={[640, 960, 1280, 1600]}
                sizes="(min-width: 68rem) 43rem, (min-width: 640px) 66vw, calc(100vw - 3rem)"
              />
              <figcaption class="mt-3 font-mono text-[0.72rem] tracking-[0.08em] text-ink-faint">
                {b.imgCaption}
              </figcaption>
            </figure>
            {b.extra && (
              <figure class="reveal sm:mt-14">
                <Image
                  src={b.extra}
                  alt={b.extraAlt}
                  class="aspect-square w-full object-cover mix-blend-multiply"
                  widths={[400, 640, 960]}
                  sizes="(min-width: 68rem) 21rem, (min-width: 640px) 33vw, calc(100vw - 3rem)"
                />
                <figcaption class="mt-3 font-mono text-[0.72rem] tracking-[0.08em] text-ink-faint">
                  {b.extraCaption}
                </figcaption>
              </figure>
            )}
          </div>
          <a href="/enquire" class="btn reveal mt-10">
            {b.cta}
          </a>
        </div>
      </section>
    ))
  }

  <section class="border-t border-line bg-paper-deep">
    <div class="mx-auto max-w-[68rem] px-6 py-16">
      <h2 class="font-display text-title reveal text-ink">Not sure what fits?</h2>
      <p class="reveal mt-4 max-w-xl leading-relaxed text-ink-soft">
        You do not need to arrive with a finished concept. Tell us about the
        place, people and occasion. We can recommend an existing format or
        create something entirely new.
      </p>
      <a href="/enquire" class="btn reveal mt-8">Start a conversation</a>
    </div>
  </section>
</Base>
