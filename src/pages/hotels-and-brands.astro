---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import hotelReading from '../assets/photos/hotel-reading.jpg';
import listeningGallery from '../assets/photos/listening-gallery.jpg';
import typewriterLobby from '../assets/photos/typewriter-lobby.jpg';
// TODO: volcar el copy completo de FOR HOTELS AND BRANDS.
// Página fuera de la nav principal: se linkea desde la Home y se usa
// como URL directa en outreach comercial.
---

<Base
  title="For hotels and brands — Verseworks"
  description="Give every guest something that did not exist before they arrived. Live, multilingual poetry activations for hotels, hospitality spaces, brands and private events."
>
  <section class="mx-auto max-w-[68rem] px-6 pt-[10vh] pb-16">
    <h1 class="font-display text-hero max-w-4xl text-ink">
      Give every guest something that did not exist before they arrived.
    </h1>
    <p class="mt-8 max-w-xl leading-relaxed text-ink-soft">
      Verseworks creates live, multilingual poetry activations for hotels,
      hospitality spaces, brands and private events. Each experience is
      personal enough to feel intimate and beautifully produced enough to
      belong within the wider identity of the host.
    </p>
    <a href="/enquire" class="btn mt-10">Create an experience</a>
  </section>

  <figure class="reveal border-t border-line">
    <Image
      src={hotelReading}
      alt="A poet reading aloud to a small group of guests in a modern hotel lobby"
      class="aspect-[3/2] w-full object-cover sm:aspect-[2/1]"
      widths={[768, 1088, 1600, 2048]}
      sizes="100vw"
    />
  </figure>

  <section class="border-t border-line bg-paper-deep">
    <div class="mx-auto max-w-[68rem] px-6 py-16 lg:py-24">
      <figure class="reveal max-w-2xl">
        <Image
          src={typewriterLobby}
          alt="A quiet hotel corner with a green typewriter on a wooden desk between two armchairs"
          class="aspect-[4/3] w-full object-cover"
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 42rem, calc(100vw - 3rem)"
        />
      </figure>
    </div>
  </section>

  <figure class="reveal border-t border-line">
    <Image
      src={listeningGallery}
      alt="A visitor with headphones listening to a poem in a white gallery space"
      class="aspect-[16/9] w-full object-cover sm:aspect-[21/9]"
      widths={[768, 1088, 1600, 2048]}
      sizes="100vw"
    />
  </figure>
</Base>
