---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import calligraphyStroke from '../assets/photos/calligraphy-stroke.jpg';
import collectiveWall from '../assets/photos/collective-wall.jpg';
import exchangeIntimate from '../assets/photos/exchange-intimate.jpg';
import installationSquare from '../assets/photos/installation-square.jpg';
import performanceCrowd from '../assets/photos/performance-crowd.jpg';
import projectionFacade from '../assets/photos/projection-facade.jpg';
import workshopTable from '../assets/photos/workshop-table.jpg';

const heroWords = ['This', 'is', 'a', 'poem.'];

const services = [
  {
    title: 'Live Experiences',
    body: 'Personal poems written for guests in real time, alongside performances, poetic interventions and tangible keepsakes.',
    cta: 'Explore live experiences',
    href: '/experiences#live',
    img: performanceCrowd,
    imgAlt: 'A poet performing surrounded by a standing audience in a contemporary venue',
    caption: 'fig. 01 — a poem, performed',
    verse: 'listen.',
  },
  {
    title: 'Participatory Programmes',
    body: 'Workshops, public programmes and community projects that invite people to write, speak, listen and create together.',
    cta: 'Explore programmes',
    href: '/experiences#programmes',
    img: workshopTable,
    imgAlt: 'A group talking and writing together around a large table during a workshop',
    caption: 'fig. 02 — a collective draft',
    verse: 'write.',
  },
  {
    title: 'Creative Commissions',
    body: 'Original texts, installations, public art and bespoke poetic concepts developed in response to a place, event, audience or idea.',
    cta: 'Explore commissions',
    href: '/experiences#commissions',
    img: installationSquare,
    imgAlt: 'People walking between large text installations in a public square',
    caption: 'fig. 03 — verses, in public',
    verse: 'keep.',
  },
];

const places = [
  'In the lobby of a hotel.',
  'At a literary festival.',
  'Around a dinner table.',
  'Inside a museum.',
  'Across the walls of a city.',
  'At a product launch.',
  'Within an immersive performance.',
  'In the hands of every guest as they leave.',
];

const audiences = [
  {
    title: 'Festivals and cultural institutions',
    body: 'Live poetry, performances, workshops and public programmes that invite audiences into the work.',
  },
  {
    title: 'Hotels and hospitality',
    body: 'Intimate cultural experiences for guests, dinners, seasonal programming, retreats and significant occasions.',
    href: '/hotels-and-brands',
  },
  {
    title: 'Brands and creative agencies',
    body: 'Human, thoughtful activations for launches, campaigns, retail environments and client events.',
    href: '/hotels-and-brands',
  },
  {
    title: 'Public spaces and communities',
    body: 'Collaborative poems, installations and participatory projects that make space for many voices.',
  },
];

// Marginalia: seis versos que viven en el margen y se reúnen al final.
// Placeholder poético — editable por la clienta.
const margins = [
  'a memory, offered',
  'a poet, listening',
  'a room, leaning in',
  'a line, passed hand to hand',
  'a language, arriving',
  'a poem, kept',
];
---

<Base
  title="Verseworks — This is a poem."
  description="Verseworks is a multilingual poetry studio creating live, participatory experiences for festivals, cultural institutions, immersive events, hotels and brands."
>
  <!-- 1 · Intriga: tipografía sola sobre papel -->
  <section class="mx-auto max-w-[68rem] px-6 pt-[14vh] pb-[12vh]">
    <h1 class="font-display text-hero text-ink">
      {
        heroWords.map((w, i) => (
          <Fragment>
            {/* El espacio vive FUERA del span: dentro de un inline-block se colapsa */}
            <span
              class:list={['hero-word', i === heroWords.length - 1 && 'cursor italic']}
              style={`animation-delay:${(0.15 + i * 0.34).toFixed(2)}s`}
            >{w}</span>
            {i < heroWords.length - 1 && ' '}
          </Fragment>
        ))
      }
    </h1>
    <p class="font-reading mt-8 max-w-xl text-lg text-ink-soft">
      Live words for memorable gatherings.
    </p>
    <p class="mt-6 max-w-xl text-[0.98rem] leading-relaxed text-ink-soft">
      Verseworks is a multilingual poetry studio creating live, participatory
      experiences for festivals, cultural institutions, immersive events, hotels
      and brands.
    </p>
    <a href="/enquire" class="btn mt-10">Plan a poetry experience</a>
  </section>

  <!-- 2 · Explicación: pliego de libro — texto a la izquierda, foto sangrada -->
  <section class="relative border-t border-line">
    <p class="marginalia reveal mt-16 px-6 lg:px-0">{margins[0]}<br />{margins[1]}</p>
    <div class="grid lg:grid-cols-2">
      <div class="px-6 py-16 lg:gutter-l lg:py-24 lg:pr-16">
        <p class="kicker reveal">Poetry, happening here</p>
        <div class="font-reading mt-8 max-w-xl space-y-5 text-xl text-ink">
          <p class="reveal">A guest offers a memory, a feeling, a place or a few words.</p>
          <p class="reveal pl-[1.5em]">A poet listens.</p>
          <p class="reveal">
            Minutes later, something new exists: an original poem, written for
            that person in that moment.
          </p>
        </div>
        <p class="reveal mt-8 max-w-xl leading-relaxed text-ink-soft">
          It might be typed, handwritten, printed, projected or spoken aloud. It
          might be created in English, Arabic, French, Spanish or another language
          chosen for the audience. The poem becomes an encounter and part of the
          bigger story.
        </p>
        <p class="font-display text-title reveal mt-12 italic">
          We turn audiences from spectators into participants.
        </p>
      </div>
      <figure class="reveal border-t border-line lg:border-t-0 lg:border-l">
        <Image
          src={projectionFacade}
          alt="Lines of projected text sweeping across a building facade at night as people watch from below"
          class="h-72 w-full object-cover sm:h-96 lg:h-full"
          widths={[640, 960, 1280, 1920]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- 3 · Servicios: láminas apoyadas sobre el escritorio, en zigzag -->
  <section class="relative overflow-hidden border-t border-line bg-paper-deep">
    <p class="marginalia reveal mt-16 px-6 lg:px-0">{margins[2]}</p>
    <div class="mx-auto max-w-[68rem] px-6 py-16 lg:py-24">
      <p class="kicker reveal">What we create</p>
      <ul class="mt-14 space-y-20 lg:mt-20 lg:space-y-28">
        {
          services.map((s, i) => (
            <li class="grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
              <figure
                class:list={[
                  'reveal relative',
                  i % 2 === 0
                    ? 'lg:col-span-6 lg:col-start-1'
                    : 'lg:col-span-6 lg:col-start-7 lg:row-start-1',
                  i === 2 && 'lg:col-start-2',
                ]}
              >
                <Image
                  src={s.img}
                  alt={s.imgAlt}
                  class="aspect-[4/3] w-full object-cover mix-blend-multiply"
                  style={`rotate:${['-1.2deg', '1deg', '-0.7deg'][i]}`}
                  widths={[480, 800, 1120]}
                  sizes="(min-width: 1024px) 32rem, calc(100vw - 3rem)"
                />
                <span
                  aria-hidden="true"
                  class:list={[
                    'font-display reveal absolute -top-7 text-[1.6rem] italic text-ink/70 lg:text-[2rem]',
                    i % 2 === 0 ? '-right-2 lg:-right-8' : '-left-2 lg:-left-8',
                  ]}
                  style={`rotate:${['1.6deg', '-1.4deg', '1deg'][i]};transition-delay:280ms`}
                >
                  {s.verse}
                </span>
                <figcaption class="mt-3 font-mono text-[0.72rem] tracking-[0.08em] text-ink-faint">
                  {s.caption}
                </figcaption>
              </figure>
              <div
                class:list={[
                  'reveal lg:col-span-5',
                  i % 2 === 0 ? 'lg:col-start-8' : 'lg:col-start-1 lg:row-start-1',
                  i === 1 && 'lg:pb-14',
                  i === 2 && 'lg:pt-10',
                ]}
                style="transition-delay:120ms"
              >
                <h2 class="font-display text-display text-ink">{s.title}</h2>
                <p class="mt-4 max-w-md leading-relaxed text-ink-soft">{s.body}</p>
                <a
                  href={s.href}
                  class="kicker mt-6 inline-block text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
                >
                  {s.cta} →
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4 · Posibilidades: letanía de lugares, sobre tinta -->
  <section class="relative border-t border-line bg-ink text-paper">
    <p class="marginalia marginalia--paper reveal mt-16 px-6 lg:px-0">{margins[3]}</p>
    <div class="mx-auto max-w-[68rem] px-6 pt-16 lg:pt-24">
      <h2 class="font-display text-display reveal max-w-3xl">
        One poet. One typewriter. An entire room transformed.
      </h2>
      <p class="reveal mt-6 text-paper/70">Verseworks can appear almost anywhere.</p>
      <ul class="font-reading mt-10 max-w-2xl text-xl">
        {
          places.map((p, i) => (
            <li
              class="reveal border-b border-paper/15 py-3 last:border-b-0"
              style={`transition-delay:${i * 60}ms`}
            >
              {p}
            </li>
          ))
        }
      </ul>
      <p class="reveal mt-8 max-w-2xl pb-14 text-paper/70 lg:pb-20">
        Each experience is developed for the people and place it belongs to.
      </p>
    </div>
    <figure class="reveal">
      <Image
        src={collectiveWall}
        alt="Many people writing at the same time on a large wall covered in collective text"
        class="aspect-[16/9] w-full object-cover sm:aspect-[21/9]"
        widths={[768, 1088, 1600, 2048]}
        sizes="100vw"
      />
    </figure>
  </section>

  <!-- 5 · Audiencias -->
  <section class="relative border-t border-line bg-paper-deep">
    <div class="mx-auto max-w-[68rem] px-6 py-16 lg:py-24">
      <p class="kicker reveal">For gatherings of every kind</p>
      <div class="mt-10 grid gap-x-14 gap-y-12 sm:grid-cols-2">
        {
          audiences.map((a) => (
            <div class="reveal">
              <h3 class="font-display text-[1.35rem] text-ink">{a.title}</h3>
              <p class="mt-3 leading-relaxed text-ink-soft">{a.body}</p>
              {a.href && (
                <a
                  href={a.href}
                  class="kicker mt-4 inline-block text-ink underline decoration-line underline-offset-4 transition-colors hover:decoration-ink"
                >
                  See what we create →
                </a>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 6 · Multilingüe -->
  <section class="relative border-t border-line">
    <p class="marginalia reveal mt-16 px-6 lg:px-0">{margins[4]}</p>
    <div class="mx-auto max-w-[68rem] px-6 py-16 lg:py-24">
      <p class="kicker reveal">Made in many languages</p>
      <h2 class="font-display text-display reveal mt-6 max-w-3xl text-ink">
        This is a <span id="lang-swap" class="lang-swap italic">poem.</span>
      </h2>
      <p class="reveal mt-8 max-w-2xl leading-relaxed text-ink-soft">
        Language shapes how we remember, express ourselves and connect with one
        another. Verseworks works with multilingual poets and collaborators to
        create experiences that reflect the language and cultural context of
        each audience.
      </p>
      <p class="font-reading reveal mt-6 max-w-2xl text-lg text-ink">
        One event may unfold in one language or many. The poem still begins in
        the same place: with someone listening.
      </p>
      <figure class="reveal mt-12 max-w-2xl">
        <Image
          src={calligraphyStroke}
          alt="A calligrapher making one large gestural brushstroke of ink across paper on the floor"
          class="aspect-[3/2] w-full object-cover mix-blend-multiply"
          widths={[640, 960, 1280]}
          sizes="(min-width: 768px) 42rem, calc(100vw - 3rem)"
        />
      </figure>
    </div>
  </section>

  <!-- 7 · A poem belongs here -->
  <section class="relative border-t border-line">
    <p class="marginalia reveal mt-16 px-6 lg:px-0">{margins[5]}</p>
    <div class="mx-auto max-w-[68rem] px-6 py-16 lg:py-24">
      <p class="kicker reveal">A poem belongs here</p>
      <p class="font-reading reveal mt-8 max-w-2xl text-lg leading-relaxed text-ink">
        Every project begins with its setting. We do not place the same
        activation into every room. We consider who will be there, how they will
        encounter the work and what they might carry away from it.
      </p>
      <p class="reveal mt-6 max-w-2xl leading-relaxed text-ink-soft">
        From one poet at an intimate gathering to a multilingual programme
        across an entire festival, Verseworks can shape the concept, select the
        artists and support the experience from beginning to end.
      </p>
      {/* La foto cruza el borde hacia el bloque de tinta */}
      <figure class="reveal relative z-10 mt-12 ml-auto w-64 -mb-20 sm:w-80 sm:-mb-24">
        <Image
          src={exchangeIntimate}
          alt="A poet writing in a notebook while listening closely to a participant in a bright room"
          class="aspect-[4/5] w-full object-cover"
          widths={[480, 800, 1120]}
          sizes="20rem"
        />
      </figure>
    </div>
  </section>

  <!-- 8 · El margen, reunido + invitación -->
  <section class="border-t border-line bg-ink text-paper">
    <div class="mx-auto max-w-[68rem] px-6 pt-32 pb-20 lg:pt-40 lg:pb-28">
      <p class="reveal font-mono text-[0.8rem] leading-loose text-paper/60">
        {margins.map((m) => <span class="block">{m}</span>)}
      </p>
      <h2 class="font-display text-display reveal mt-12 max-w-3xl">
        What are you gathering people for?
      </h2>
      <p class="reveal mt-6 max-w-xl text-paper/70">
        Tell us what you are planning. We will help find the poem inside it.
      </p>
      <a
        href="/enquire"
        class="btn reveal mt-10 border-paper text-paper hover:bg-paper hover:text-ink"
        >Start a conversation</a
      >
    </div>
  </section>

  <script>
    const el = document.getElementById('lang-swap');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (el && !reduced) {
      const words = [
        { t: 'poem.', lang: 'en', dir: 'ltr' },
        { t: 'poème.', lang: 'fr', dir: 'ltr' },
        { t: 'poema.', lang: 'es', dir: 'ltr' },
        { t: 'قصيدة.', lang: 'ar', dir: 'rtl' },
      ];
      let i = 0;
      el.style.transition = 'opacity 0.35s ease';
      setInterval(() => {
        el.style.opacity = '0';
        setTimeout(() => {
          i = (i + 1) % words.length;
          const w = words[i];
          el.textContent = w.t;
          el.setAttribute('lang', w.lang);
          el.setAttribute('dir', w.dir);
          el.style.opacity = '1';
        }, 360);
      }, 2600);
    }
  </script>
</Base>
