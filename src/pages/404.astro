>
  <section class="mx-auto max-w-[68rem] px-6 pt-[14vh] pb-[14vh]">
    <p class="kicker">404</p>
    <h1 class="font-display text-hero cursor mt-6 max-w-4xl italic text-ink">
      This page is not a poem.
    </h1>
    <p class="mt-8 max-w-xl leading-relaxed text-ink-soft">
      Nothing lives at this address — the line you followed ends here. The rest
      of the book is still open.
    </p>
    <a href="/" class="btn mt-10">Back to the beginning</a>
  </section>
</Base>
